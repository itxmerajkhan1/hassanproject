rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Helper Functions & Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Secure Server-Controlled Admin Authorization:
    // 1. Firebase Auth Custom Claims: request.auth.token.admin == true
    // 2. Server-protected admin registry in /admins/{uid}
    // 3. Designated root administrator emails verified in auth token
    // (Never trust editable client document fields alone)
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email in ['merajkhan3109@gmail.com', 'itxmerajkhan3109@gmail.com'] ||
          request.auth.token.email.matches('(?i)^(merajkhan3109|itxmerajkhan3109)@gmail[.]com$')
        ))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Collection Rules

    // Products: Public visitors can read products; only authorized admins can create, edit, or delete
    // Public visitors can increment the product views counter when browsing
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['views']) &&
        incoming().views is number &&
        incoming().views >= existing().views
      );
    }

    // Categories: Public visitors can read categories; only authorized admins can modify
    match /categories/{categoryId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // Hero Banners: Public visitors can read active banners; only authorized admins can manage slides
    match /heroBanners/{bannerId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // Website Settings: Public visitors can read published settings; only authorized admins can edit
    match /websiteSettings/{settingId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // Admin Registry: Authenticated users can check admin status; only verified admins can write/grant entries
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write, create, update, delete: if isAdmin();
    }

    // User Profiles: Private read/write for owner, management for verified admins
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // On registration, public users CANNOT self-assign admin role
      allow create: if isOwner(userId) && (
        incoming().role == 'user' ||
        (incoming().role == 'admin' && isAdmin())
      );

      // Customers can update permitted profile fields; cannot self-promote to admin or change UID/email
      allow update: if (
        isAdmin() ||
        (
          isOwner(userId) &&
          !incoming().diff(existing()).affectedKeys().hasAny(['role', 'uid', 'email'])
        )
      );

      allow delete: if isAdmin();
    }

    // Orders: Customers can access only their own orders; admins can manage logistics and status
    // Insecure guest wildcard read removed; orders protected from unauthorized exposure
    match /orders/{orderId} {
      allow get: if (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );

      allow list: if (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );

      // Verified order creation (signed in customer or validated guest checkout)
      allow create: if (
        isAdmin() ||
        (
          isSignedIn() &&
          incoming().userId == request.auth.uid &&
          incoming().total is number &&
          incoming().total >= 0 &&
          incoming().items is list &&
          incoming().items.size() > 0 &&
          incoming().shippingAddress is map
        ) ||
        (
          !isSignedIn() &&
          incoming().userId is string &&
          incoming().userId.matches('^guest-.*') &&
          incoming().total is number &&
          incoming().total >= 0 &&
          incoming().items is list &&
          incoming().items.size() > 0 &&
          incoming().shippingAddress is map
        )
      );

      // Customers can only update shipping address before dispatch; cannot modify financial/status fields
      allow update: if (
        isAdmin() ||
        (
          isSignedIn() &&
          resource.data.userId == request.auth.uid &&
          resource.data.orderStatus == 'Pending' &&
          incoming().userId == request.auth.uid &&
          incoming().diff(existing()).affectedKeys().hasOnly(['shippingAddress'])
        )
      );

      allow delete: if isAdmin();
    }

    // Reviews: Public can read reviews; users can submit and toggle likes; admins moderate
    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if (
        isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().likes == 0 &&
        incoming().likedBy.size() == 0 &&
        incoming().productId is string &&
        incoming().userName is string &&
        incoming().comment is string &&
        incoming().comment.size() <= 2000 &&
        incoming().rating is number &&
        incoming().rating >= 1 &&
        incoming().rating <= 5
      );

      // Support toggling review likes by users OR full admin editing
      allow update: if (
        isAdmin() ||
        (
          isSignedIn() &&
          incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'likedBy']) &&
          incoming().likes == incoming().likedBy.size() &&
          (
            (request.auth.uid in existing().likedBy && !(request.auth.uid in incoming().likedBy) && incoming().likes == existing().likes - 1) ||
            (!(request.auth.uid in existing().likedBy) && request.auth.uid in incoming().likedBy && incoming().likes == existing().likes + 1)
          )
        )
      );

      allow delete: if (
        isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid)
      );
    }

    // Coupons: Public can read active coupons for checkout validation; only admins can create or edit
    match /coupons/{couponId} {
      allow read: if true;
      allow write, create, update, delete: if isAdmin();
    }

    // Carts: Isolated to owner or admin
    match /carts/{cartId} {
      allow get, delete: if isSignedIn() && (isOwner(cartId) || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (isOwner(cartId) || incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (isOwner(cartId) || resource.data.userId == request.auth.uid || isAdmin());
    }

    // Wishlists: Isolated to owner or admin
    match /wishlists/{wishlistId} {
      allow get, delete: if isSignedIn() && (isOwner(wishlistId) || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (isOwner(wishlistId) || incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (isOwner(wishlistId) || resource.data.userId == request.auth.uid || isAdmin());
    }

    // Inventory Logs: Admin-only stock audit trails
    match /inventoryLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // Subscribers (Newsletter): Public can subscribe with valid email; admin can manage
    match /subscribers/{subId} {
      allow create: if incoming().email is string && incoming().email.matches('^[^@]+@[^@]+\\.[^@]+$');
      allow read, update, delete: if isAdmin();
    }

    // Contacts (Contact Form Messages): Public can send message with reasonable limits; admin can manage
    match /contacts/{msgId} {
      allow create: if incoming().email is string && incoming().name is string && incoming().message is string && incoming().message.size() <= 3000;
      allow read, update, delete: if isAdmin();
    }

    // 3. Default Deny All fallback for any unspecified collection or document
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
